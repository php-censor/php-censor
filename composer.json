{
    "name":              "php-censor/php-censor",
    "description":       "PHP Censor is a open source self-hosted continuous integration server for PHP projects (PHPCI fork).",
    "minimum-stability": "stable",
    "type":              "application",
    "keywords":          [
        "php",
        "php-censor",
        "phpci",
        "ci-server",
        "testing",
        "self-hosted",
        "open-source",
        "ci",
        "continuous integration"
    ],
    "homepage": "https://php-censor.info",
    "license":  "BSD-2-Clause",
    "authors":  [
        {
            "name":     "Dmitry Khomutov",
            "email":    "poisoncorpsee@gmail.com",
            "homepage": "https://corpsee.com",
            "role":     "PHP Censor developer"
        },
        {
            "name":     "Dan Cryer",
            "email":    "dan.cryer@block8.co.uk",
            "homepage": "https://www.block8.co.uk",
            "role":     "PHPCI developer"
        }
    ],
    "support": {
        "issues": "https://github.com/php-censor/php-censor/issues",
        "source": "https://github.com/php-censor/php-censor"
    },
    "autoload": {
        "psr-4": {
            "PHPCensor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\PHPCensor\\": "tests/src/"
        }
    },
    "require": {
        "php":           ">=8.4",
        "ext-openssl":   "*",
        "ext-PDO":       "*",
        "ext-json":      "*",
        "ext-dom":       "*",
        "ext-libxml":    "*",
        "ext-SimpleXML": "*",
        "ext-curl":      "*",
        "ext-bcmath":    "*",

        "symfony/http-foundation":         "^7.4 || ^8.0",
        "symfony/yaml":                    "^7.4 || ^8.0",
        "symfony/console":                 "^7.4 || ^8.0",
        "symfony/finder":                  "^7.4 || ^8.0",
        "symfony/dom-crawler":             "^7.4 || ^8.0",
        "symfony/css-selector":            "^7.4 || ^8.0",
        "symfony/browser-kit":             "^7.4 || ^8.0",
        "symfony/process":                 "^7.4 || ^8.0",
        "symfony/filesystem":              "^7.4 || ^8.0",
        "symfony/dependency-injection":    "^7.4 || ^8.0",
        "symfony/event-dispatcher":        "^7.4 || ^8.0",
        "symfony/cache":                   "^7.4 || ^8.0",
        "symfony/mailer":                  "^7.4 || ^8.0",
        "symfony/mime":                    "^7.4 || ^8.0",
        "psr/container":                   "^1.1 || ^2.0",
        "psr/log":                         "^3.0",
        "monolog/monolog":                 "^3.9",
        "pimple/pimple":                   "^3.5",
        "robmorgan/phinx":                 "^0.16",
        "sensiolabs/ansi-to-html":         "^2.0",
        "pda/pheanstalk":                  "^8.0",
        "guzzlehttp/guzzle":               "^7.9 || ^8.0",
        "jasongrimes/paginator":           "^1.0",
        "voku/anti-xss":                   "^4.1",
        "sebastian/diff":                  "^7.0 || ^8.0 || ^9.0"
    },
    "require-dev": {
        "phpunit/phpunit":                     "^13.0",
        "infection/infection":                 "^0.35",
        "phpspec/prophecy-phpunit":            "^2.4",
        "squizlabs/php_codesniffer":           "^4.0",
        "phpmd/phpmd":                         "^3.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "friendsofphp/php-cs-fixer":           "^3.90",
        "symfony/var-dumper":                  "^7.4 || ^8.0",
        "vimeo/psalm":                         "^6.0 || ^7.0",
        "rector/rector":                       "^2.2"
    },
    "extra": {
        "platform": {
            "php": "8.4"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
